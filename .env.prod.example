# UA HostPro env for docker-compose.prod.yml (Postgres + Redis in Docker).
# Copy to .env.prod on the VPS and fill in values. Do not commit .env.prod.
# Start: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# TLS: existing HostPro nginx → http://127.0.0.1:3001 (not in-stack Caddy).
#
# SK Coolify: use .env.coolify.example in the Coolify UI + docker-compose.coolify.yml.
#
# Empty PostgreSQL: migrate job runs `prisma migrate deploy`
# (active history: 00000000000000_baseline) before the API process starts.
# Host must be the compose service name `postgres` (not localhost).

NODE_ENV=production
PORT=3001

# --- PostgreSQL (internal hostname: postgres) ---
POSTGRES_USER=green_angels
POSTGRES_DB=green_angels
# generate with: openssl rand -base64 32
POSTGRES_PASSWORD=

# Host must be the compose service name `postgres` (not localhost).
# Replace <POSTGRES_PASSWORD> with the same value as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://green_angels:<POSTGRES_PASSWORD>@postgres:5432/green_angels?schema=public

# --- Redis (internal hostname: redis) ---
# Production compose enables AOF (appendfsync everysec) on volume redis_data (/data).
# AOF is crash persistence, not a backup. Existing RDB-only volumes are converted
# on first start via docker/redis-aof-entrypoint.sh (no FLUSH, volume is kept).
REDIS_HOST=redis
REDIS_PORT=6379
# generate with: openssl rand -base64 32
REDIS_PASSWORD=

# --- Auth / sessions (must match shop JWT_SECRET; min 32 chars) ---
# generate with: openssl rand -base64 32
JWT_SECRET=

# Flexi Settings encryption (min 16 chars). Falls back to JWT_SECRET if empty.
# generate with: openssl rand -base64 32
FLEXI_SECRETS_KEY=

# Vercel shop origin(s). Comma-separated for SK multi-domain.
CORS_ORIGIN=https://<vercel-домен>

# Public URLs (webhooks, payment redirects, photo links). nginx TLS on this host.
API_PUBLIC_URL=https://api.<твій-домен>
SHOP_PUBLIC_URL=https://<vercel-домен>

# --- Cloudflare R2 (canonical production media) ---
# Production always uses R2 (NODE_ENV=production ignores MEDIA_DRIVER=local
# and MEDIA_KEEP_LOCAL). Credentials stay on Nest only — never NEXT_PUBLIC_*.
MEDIA_DRIVER=r2
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=green-angels-media
R2_REGION=auto
# Public hostname in front of the bucket (Cloudflare custom domain). Not a secret.
# Same value as shop NEXT_PUBLIC_MEDIA_BASE_URL.
R2_PUBLIC_BASE_URL=https://media.<твій-домен>

# --- Google OAuth ---
# Authorized redirect URI: https://<vercel-домен>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Nova Poshta (optional if set in backstage) ---
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_JSON_API_URL=

# --- TurboSMS ---
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# --- OTP ---
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=60
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_TTL_SEC=600
# Nest IP limits: public TCP peer only (never X-Forwarded-For). BFF applies the same caps to browsers.
OTP_IP_SEND_MAX=20
OTP_IP_SEND_WINDOW_SEC=900
OTP_IP_VERIFY_MAX=60
OTP_IP_VERIFY_WINDOW_SEC=900

# Public order confirmation JWT (guest success URL). Default 2h — not Mono sync TTL.
ORDER_CONFIRMATION_TTL_SEC=7200

# --- SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- MonoPay ---
MONOPAY_TOKEN=
# MONOPAY_WEBHOOK_URL=https://api.<твій-домен>/payments/monopay/webhook

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Estimate photos / Viber ---
# generate with: openssl rand -base64 32
PHOTO_API_KEYS=
# must stay 0 in production
ENABLE_PHOTOS_DEBUG=0
# PHOTO_STORAGE_ROOT=
# PHOTO_PUBLIC_BASE_URL=https://api.<твій-домен>/uploads/estimate-photos/
MAX_PHOTOS_PER_SIZE=4
VIBER_BOT_TOKEN=
VIBER_USER_IDS=
# LEGACY_PHOTO_API_KEY=
