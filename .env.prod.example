# UA HostPro env for docker-compose.prod.yml (Postgres + Redis in Docker).
# Copy to .env.prod on the VPS and fill in values. Do not commit .env.prod.
# Start: docker compose --env-file .env.prod -f docker-compose.prod.yml up -d --build
# TLS: existing HostPro nginx → http://127.0.0.1:3001 (not in-stack Caddy).
#
# SK/Hetzner Coolify: use .env.coolify.example + docker-compose.coolify.yml.
# Do not paste Coolify Internal URLs here (hosts are compose names postgres/redis).
#
# Empty PostgreSQL: migrate job runs `prisma migrate deploy`
# (active history: 00000000000000_baseline) before the API process starts.
#
# Legend: # REQUIRED # OPTIONAL # SECRET # UA ONLY

NODE_ENV=production
PORT=3001

# --- PostgreSQL (UA ONLY — in-stack compose service `postgres`) ---
# REQUIRED
POSTGRES_USER=green_angels
# REQUIRED
POSTGRES_DB=green_angels
# REQUIRED SECRET — generate: openssl rand -base64 32
POSTGRES_PASSWORD=

# REQUIRED SECRET — host MUST be compose service name postgres (not localhost, not Coolify hostname).
# Replace <POSTGRES_PASSWORD> with the same value as POSTGRES_PASSWORD.
DATABASE_URL=postgresql://green_angels:<POSTGRES_PASSWORD>@postgres:5432/green_angels?schema=public

# --- Redis AOF (UA ONLY — in-stack compose service `redis`) ---
# docker-compose.prod.yml hardcodes REDIS_HOST=redis and REDIS_PORT=6379 on api.
# REQUIRED here so interpolation of requirepass / healthcheck works.
# AOF: appendfsync everysec on volume redis_data; first start converts RDB via docker/redis-aof-entrypoint.sh.
# REQUIRED
REDIS_HOST=redis
# REQUIRED
REDIS_PORT=6379
# REQUIRED SECRET — generate: openssl rand -base64 32
REDIS_PASSWORD=

# --- Auth / sessions (must match UA shop JWT_SECRET; min 32 chars) ---
# REQUIRED SECRET — generate: openssl rand -base64 32
JWT_SECRET=

# REQUIRED — UA Vercel/shop origin(s). Compose fallback is https://green-angels.example.com — replace it.
CORS_ORIGIN=https://<vercel-ua-домен>

# REQUIRED public — nginx TLS on this host. No :3001.
API_PUBLIC_URL=https://api.<твій-домен>
# REQUIRED public — UA storefront (payment return).
SHOP_PUBLIC_URL=https://<vercel-ua-домен>

# --- Cloudflare R2 (canonical production media) ---
# Production always uses R2 (NODE_ENV=production ignores MEDIA_DRIVER=local).
# Credentials stay on Nest only — never NEXT_PUBLIC_*.
# OPTIONAL in compose list (api also env_file .env.prod) but REQUIRED for Nest boot in production.
MEDIA_DRIVER=r2
# REQUIRED
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# REQUIRED SECRET
R2_ACCESS_KEY_ID=
# REQUIRED SECRET
R2_SECRET_ACCESS_KEY=
# REQUIRED
R2_BUCKET=green-angels-media
# OPTIONAL — Nest default auto
R2_REGION=auto
# REQUIRED public — same as shop NEXT_PUBLIC_MEDIA_BASE_URL
R2_PUBLIC_BASE_URL=https://media.<твій-домен>

# --- Google OAuth ---
# OPTIONAL — Authorized redirect URI: https://<vercel-ua-домен>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=
# OPTIONAL SECRET
GOOGLE_CLIENT_SECRET=

# --- Nova Poshta (UA ONLY; optional if set in backstage) ---
# OPTIONAL SECRET
NOVA_POSHTA_API_KEY=
# OPTIONAL
NOVA_POSHTA_JSON_API_URL=

# --- TurboSMS (UA ONLY — SMS OTP) ---
# OPTIONAL SECRET
TURBOSMS_TOKEN=
# OPTIONAL
TURBOSMS_SENDER=

# OTP_* and ORDER_CONFIRMATION_TTL_SEC have Nest defaults. Unset unless overriding.

# --- Resend (email OTP + order notifications) ---
# OPTIONAL SECRET until mail is live
RESEND_API_KEY=
MAIL_FROM_LOCAL_PART=noreply
# UA: MAIL_DOMAIN=landshaft.info
# SK: GA_COUNTRY_HOSTS=... (mirror shop)

# --- MonoPay (UA ONLY) ---
# OPTIONAL SECRET until UA card checkout is live
MONOPAY_TOKEN=
# OPTIONAL public override; default {API_PUBLIC_URL}/payments/monopay/webhook
# MONOPAY_WEBHOOK_URL=https://api.<твій-домен>/payments/monopay/webhook

# Stripe is SK-primary; Nest still reads STRIPE_* if set. Leave empty on UA unless needed.
# OPTIONAL SECRET
# STRIPE_SECRET_KEY=
# Publishable key is public (pk_) but still keep it on Nest; shop receives it with clientSecret.
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=

# --- Estimate photos / Viber (RN) ---
# OPTIONAL SECRET — generate: openssl rand -base64 32
PHOTO_API_KEYS=
# must stay 0 in production (debug 404 unless 1)
ENABLE_PHOTOS_DEBUG=0
# OPTIONAL SECRET — legacy estimate import
# LEGACY_PHOTO_API_KEY=
# OPTIONAL SECRET
VIBER_BOT_TOKEN=
# OPTIONAL
VIBER_USER_IDS=

# Flexi is SK ERP. UA Nest falls back to JWT_SECRET if FLEXI_SECRETS_KEY is unset.
# Do not add Coolify Internal hosts, NEXT_PUBLIC_*, or MAX_PHOTOS_PER_SIZE
# (retention is Backoffice catalog.freshPhotosLimit).
