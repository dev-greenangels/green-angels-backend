# SK/EU Coolify Environment Variables (paste into Coolify UI — not a VPS file).
# Compose: docker-compose.coolify.yml. Do not commit real secrets.
# Do not paste .env.prod.example (HostPro) or .env.example (dev).
#
# Coolify creates extra UI rows (shared interpolation + per-service copies).
# Unique names below ≈ the SK contract. Fill REQUIRED before first deploy.
#
# Legend
#   # REQUIRED  — api will not boot or cannot serve the shop without a real value
#   # OPTIONAL  — Nest reads it; empty = feature off (defaults in code)
#   # SECRET    — Coolify secret flag; never git, never NEXT_PUBLIC_*
#   # SK ONLY   — this file; not for HostPro
#
# Postgres + Redis stay Coolify Database resources (not this Compose).
# Start both Running before the first Nest deploy.
# Empty PostgreSQL: migrate runs `prisma migrate deploy` (baseline only).
# migrate container interpolates DATABASE_URL only.

# --- required boot ---

# REQUIRED SECRET+internal — Postgres resource Internal URL. Keep ?schema=public.
# Host = Coolify hostname from Internal URL. Not localhost. Not compose name postgres.
# SK ONLY
DATABASE_URL=postgresql://<user>:<password>@<coolify-postgres-host>:5432/<db>?schema=public

# REQUIRED internal — Redis Internal URL hostname only (between @ and :6379).
# Not localhost. Not "redis" (that hostname is HostPro in-stack only).
# Nest default port is 6379 (not interpolated; Coolify Redis uses 6379).
# SK ONLY
REDIS_HOST=<coolify-redis-host>
# REQUIRED SECRET — Redis resource password
REDIS_PASSWORD=

# REQUIRED SECRET — min 32 chars. Same value as shop JWT_SECRET on SK Vercel.
# Never NEXT_PUBLIC_*. Generate: openssl rand -base64 48
JWT_SECRET=

# REQUIRED — SK Vercel origin(s), comma-separated for .sk/.at/.hu + www
CORS_ORIGIN=https://<vercel-sk-домен>

# REQUIRED public — R2 S3 API endpoint (account URL, not the media CDN)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# REQUIRED SECRET — Nest api only. Never shop/Vercel.
R2_ACCESS_KEY_ID=
# REQUIRED SECRET
R2_SECRET_ACCESS_KEY=
# REQUIRED — SK media bucket
R2_BUCKET=
# REQUIRED public — Cloudflare custom domain in front of the bucket
# Same value as shop NEXT_PUBLIC_MEDIA_BASE_URL
R2_PUBLIC_BASE_URL=https://media.<ск-домен>

# REQUIRED public — https://api.<host> without :3001 (webhooks, absolute URLs)
API_PUBLIC_URL=https://api.<ск-домен>
# REQUIRED public — SK storefront (payment return). Comma CORS covers extra hosts.
SHOP_PUBLIC_URL=https://<vercel-sk-домен>

# --- optional SK features (empty = off; code defaults apply) ---

# OPTIONAL SECRET — Flexi settings encryption (min 16). Empty → JWT_SECRET.
# SK ONLY (UA 1C is not Nest yet)
FLEXI_SECRETS_KEY=

# OPTIONAL — also on shop as NEXT_PUBLIC_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# OPTIONAL SECRET
GOOGLE_CLIENT_SECRET=

# OPTIONAL — SMTP_HOST/PORT default smtp.gmail.com:587 in Nest
# OPTIONAL SECRET
SMTP_USER=
# OPTIONAL SECRET
SMTP_PASS=
# OPTIONAL
SMTP_FROM=

# OPTIONAL SECRET — SK card payments
STRIPE_SECRET_KEY=
# Publishable key (pk_) — returned to shop with Stripe client_secret; not a secret
STRIPE_PUBLISHABLE_KEY=
# OPTIONAL SECRET
STRIPE_WEBHOOK_SECRET=

# OPTIONAL SECRET — RN Estimate /photos (except public Viber webhook)
PHOTO_API_KEYS=
# OPTIONAL SECRET — legacy estimate import
LEGACY_PHOTO_API_KEY=
# OPTIONAL SECRET
VIBER_BOT_TOKEN=
# OPTIONAL
VIBER_USER_IDS=

# OPTIONAL SECRET — Gemini PDF invoice parsing (backstage supplier invoices)
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Free-tier models (switch in UI when hitting RPM/RPD): gemini-3.6-flash, gemini-3.5-flash-lite, gemini-3.1-flash-lite, gemini-3.5-flash, gemini-3.7-flash
# FLEXI_RECEIVED_INVOICE_DOC_TYPE=FAKTURA
# typ-faktury-prijate.kod — у цій інстанції: FAKTURA (не FP)

# NODE_ENV=production, PORT=3001, MEDIA_DRIVER=r2, ENABLE_PHOTOS_DEBUG=0
# are hardcoded in docker-compose.coolify.yml (not interpolated).
# REDIS_PORT defaults to 6379 in Nest. OTP_* / ORDER_CONFIRMATION_TTL_SEC
# have Nest defaults. Do not add POSTGRES_*, NEXT_PUBLIC_*, MONOPAY_*,
# NOVA_POSHTA_*, TURBOSMS_*, MAX_PHOTOS_PER_SIZE, UPLOAD_ROOT.
