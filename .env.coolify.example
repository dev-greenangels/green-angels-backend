# SK/EU Coolify Environment Variables (paste into Coolify UI — not a VPS file).
# Compose: docker-compose.coolify.yml. Do not commit real secrets.
#
# Legend
#   secret     — Coolify secret / Build Variable; never git, never NEXT_PUBLIC_*
#   public     — hostname or non-sensitive id safe to copy (still not always for browsers)
#   internal   — Coolify resource Internal URL / hostname (not localhost, not VPS public IP)
#
# Postgres + Redis stay Coolify Database resources (not this Compose).
# Start both Running before the first Nest deploy.
# Empty PostgreSQL: migrate runs `prisma migrate deploy` (baseline).

# --- boot (required) ---

# public — compose hardcodes production on api + migrate
NODE_ENV=production
# public — compose hardcodes 3001
PORT=3001

# secret + internal — Postgres resource Internal URL. Keep ?schema=public.
# Host = Coolify postgres hostname from Internal URL (not localhost, not compose name postgres).
DATABASE_URL=postgresql://<user>:<password>@<coolify-postgres-host>:5432/<db>?schema=public

# internal — Redis URL (internal) hostname only (between @ and :6379). Not localhost. Not "redis".
REDIS_HOST=<coolify-redis-host>
# public — Redis container port (usually 6379), not a host mapping like 3000
REDIS_PORT=6379
# secret — Redis resource password
REDIS_PASSWORD=

# secret — min 32 chars; same value as shop JWT_SECRET on SK Vercel. Never NEXT_PUBLIC_*.
JWT_SECRET=

# public — SK Vercel origin(s), comma-separated for multi-domain
CORS_ORIGIN=https://<vercel-sk-домен>

# public — compose default r2; production Nest forces r2 even if this is wrong
MEDIA_DRIVER=r2

# public — R2 S3 API endpoint (account URL, not the media CDN)
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# secret — Nest api container only. Never NEXT_PUBLIC_*. Never shop/Vercel.
R2_ACCESS_KEY_ID=
# secret
R2_SECRET_ACCESS_KEY=
# public — SK media bucket name
R2_BUCKET=
# public — usually auto
R2_REGION=auto
# public — Cloudflare custom domain in front of the bucket (same as shop NEXT_PUBLIC_MEDIA_BASE_URL)
R2_PUBLIC_BASE_URL=https://media.<ск-домен>

# --- required for real shop traffic (not always for /health) ---

# public — https://api.<host> without :3001 (webhooks, absolute photo URLs)
API_PUBLIC_URL=https://api.<ск-домен>
# public — SK storefront URL (payment return). Falls back to CORS_ORIGIN if empty.
SHOP_PUBLIC_URL=https://<vercel-sk-домен>
# secret — Flexi settings encryption (min 16). Falls back to JWT_SECRET if empty.
FLEXI_SECRETS_KEY=

# --- optional feature secrets / settings ---

# public Client ID is also on shop as NEXT_PUBLIC_GOOGLE_CLIENT_ID; secret stays Nest-only
GOOGLE_CLIENT_ID=
# secret
GOOGLE_CLIENT_SECRET=

# optional SK; often set in backstage instead
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_JSON_API_URL=

# secret
TURBOSMS_TOKEN=
# public sender name
TURBOSMS_SENDER=

OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=60
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_TTL_SEC=600
OTP_IP_SEND_MAX=20
OTP_IP_SEND_WINDOW_SEC=900
OTP_IP_VERIFY_MAX=60
OTP_IP_VERIFY_WINDOW_SEC=900
OTP_IP_HINT_MAX=30
OTP_IP_HINT_WINDOW_SEC=900

ORDER_CONFIRMATION_TTL_SEC=7200

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# secret
SMTP_USER=
# secret
SMTP_PASS=
SMTP_FROM=

# secret — UA payments; optional on SK
MONOPAY_TOKEN=
# public override; default {API_PUBLIC_URL}/payments/monopay/webhook
MONOPAY_WEBHOOK_URL=
# secret — SK card payments
STRIPE_SECRET_KEY=
# secret
STRIPE_WEBHOOK_SECRET=

# secret — RN Estimate /photos (except public Viber webhook)
PHOTO_API_KEYS=
# public — must stay 0 in production
ENABLE_PHOTOS_DEBUG=0
MAX_PHOTOS_PER_SIZE=4
# optional if R2_PUBLIC_BASE_URL is set
PHOTO_PUBLIC_BASE_URL=
# secret — optional legacy estimate import
LEGACY_PHOTO_API_KEY=
# secret
VIBER_BOT_TOKEN=
VIBER_USER_IDS=
