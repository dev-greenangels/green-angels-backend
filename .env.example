NODE_ENV=development
PORT=3001

# PostgreSQL
# — API в Docker (docker compose up): DATABASE_URL задається в docker-compose.yml (host postgres)
# — API на хості (npm run start:dev): використовуйте localhost
DATABASE_URL=postgresql://green_angels:green_angels@localhost:5432/green_angels?schema=public

# Redis
# — API в Docker: REDIS_HOST=redis (у docker-compose.yml)
# — API на хості: localhost
REDIS_HOST=localhost
REDIS_PORT=6379

# Той самий секрет, що й AUTH_SESSION_SECRET у green-angels-shop (мін. 32 символи)
JWT_SECRET=dev-only-green-angels-session-secret-min-32-chars!!

# Шифрування пароля / webhookSecKey ABRA Flexi у Settings (мін. 16 символів).
# Якщо не задано — використовується JWT_SECRET (з попередженням у логах).
# FLEXI_SECRETS_KEY=dev-only-flexi-secrets-key-min-16

# Next.js shop origin(s). Comma-separated for SK multi-domain:
# CORS_ORIGIN=https://green-angels.sk,https://www.green-angels.sk,https://green-angels.hu,https://www.green-angels.hu,https://green-angels.at,https://www.green-angels.at
CORS_ORIGIN=http://localhost:3000

# Google OAuth — Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web)
# Authorized redirect URI (локально): http://localhost:3000/api/auth/oauth/google/callback
# GOOGLE_CLIENT_ID і NEXT_PUBLIC_GOOGLE_CLIENT_ID — одне й те саме значення Client ID
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Nova Poshta (опційно; якщо не вказано в бек-офісі)
NOVA_POSHTA_API_KEY=
NOVA_POSHTA_JSON_API_URL=

# TurboSMS — HTTP API (кабінет → Connection Methods → HTTP API)
TURBOSMS_TOKEN=
TURBOSMS_SENDER=

# OTP (SMS-авторизація)
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=60
OTP_VERIFY_MAX_ATTEMPTS=5
OTP_VERIFICATION_TOKEN_TTL_SEC=600
# IP windows apply only to a public TCP peer on Nest (not X-Forwarded-For).
# Browser users behind Next BFF share a private hop — BFF enforces the same limits.
OTP_IP_SEND_MAX=20
OTP_IP_SEND_WINDOW_SEC=900
OTP_IP_VERIFY_MAX=60
OTP_IP_VERIFY_WINDOW_SEC=900

# Public order confirmation JWT (guest success URL). Default 2h — not Mono sync TTL.
ORDER_CONFIRMATION_TTL_SEC=7200

# Gmail SMTP (OTP на email) — App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Monopay (Plata by Mono) — токен з https://web.monobank.ua/ або тестовий з https://api.monobank.ua/
MONOPAY_TOKEN=
# Публічна URL магазину — redirect після оплати (браузер)
# SHOP_PUBLIC_URL=http://localhost:3000
# Webhook: Mono → Nest напряму. За замовчуванням {API_PUBLIC_URL}/payments/monopay/webhook
# MONOPAY_WEBHOOK_URL=https://your-api-tunnel.example/payments/monopay/webhook

# Stripe (альтернативний провайдер card-online, обирається в бек-офісі → Налаштування → Кошик)
# Secret key: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
# Webhook signing secret: https://dashboard.stripe.com/webhooks → endpoint {API_PUBLIC_URL}/payments/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# --- Estimate photos (мобільний додаток) ---
# Заголовок x-api-key для /photos/*
PHOTO_API_KEYS=
ENABLE_PHOTOS_DEBUG=0  # 1 only for local debugging, never in prod
# За замовчуванням: {UPLOAD_ROOT}/estimate-photos (див. нижче)
# PHOTO_STORAGE_ROOT=
# Публічний URL API (фото / Viber / Mono webhook за замовчуванням)
# Локально з tunnel: https://xxxx.loca.lt (порт 3001)
# API_PUBLIC_URL=http://localhost:3001
# Або повний префікс публічних URL фото
# PHOTO_PUBLIC_BASE_URL=http://localhost:3001/uploads/estimate-photos/
# Макс. фото на один sizeId (старіші видаляються)
MAX_PHOTOS_PER_SIZE=4
# Viber (опційно; отримувачів також можна керувати в бек-офісі)
VIBER_BOT_TOKEN=
VIBER_USER_IDS=
# Синхронізація фото з legacy estimate-photo сервера (бек-офіс)
# x-api-key для GET …/photos/list-all (можна також передати з форми бек-офісу)
# LEGACY_PHOTO_API_KEY=

# Єдиний корінь медіа (products, categories, reviews, blog, estimate-photos).
# Лише локальна розробка (MEDIA_DRIVER=local). Production пише в R2.
# Monorepo локально: ../data/uploads від green-angels-backend
# Docker (docker-compose.yml): /data/uploads (volume ../data/uploads:/data/uploads)
# UPLOAD_ROOT=/Users/user/DevProjects/green-angels-project/data/uploads

# --- Cloudflare R2 ---
# Dev default: local disk. Production (NODE_ENV=production) always uses r2.
# MEDIA_DRIVER=local
# MEDIA_KEEP_LOCAL=false
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_REGION=auto
