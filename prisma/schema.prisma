datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. БЛОК КОРИСТУВАЧІВ, РОЛЕЙ ТА КОНТРАГЕНТІВ (1С)
// ==========================================

enum Role {
  GUEST
  USER
  WHOLESALER
  ADMIN
  MANAGER
}

enum AuthProvider {
  GOOGLE
  PHONE
}

/// Fresh Photos identity: UA uses EAN, SK uses SKU. Same PhotoIndex table.
enum PhotoIdentifierType {
  EAN
  SKU
}

model User {
  id                 String    @id @default(uuid())
  phone              String?   @unique
  email              String?   @unique
  firstName          String?
  lastName           String?
  patronymic         String?
  phoneVerified      Boolean   @default(false)
  emailVerified      Boolean   @default(false)
  deliveryDefaults   Json?
  passwordHash       String?
  role               Role      @default(USER)
  /// PrestaShop id_customer (import)
  legacyId           String?
  legacySource       String?
  newsletter         Boolean   @default(false)
  optin              Boolean   @default(false)
  marketingConsentAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts                       Account[]
  contractorProfiles             ContractorProfile[]
  cart                           Cart?
  orders                         Order[]
  reviews                        Review[]
  favorites                      UserFavorite[]
  customerGroups                 UserCustomerGroup[]
  promoCodeUsages                PromoCodeUsage[]
  promoCodeAllowances            PromoCodeUser[]
  discountRuleAllowances         DiscountRuleUser[]
  referralCode                   ReferralCode?
  referralAttributionsAsReferrer ReferralAttribution[] @relation("ReferralReferrer")
  referralAttributionsAsReferee  ReferralAttribution[] @relation("ReferralReferee")
  pointsLedger                   PointsLedgerEntry[]
  legalConsentEvents             LegalConsentEvent[]
  contractWithdrawals            ContractWithdrawal[]

  @@unique([legacySource, legacyId])
  @@index([legacyId])
}

model Account {
  id         String       @id @default(uuid())
  provider   AuthProvider
  providerId String
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
}

model ContractorProfile {
  id           String @id @default(uuid())
  externalId1C String @unique
  name         String
  discountRate Int    @default(0)
  priceType    String @default("роздріб")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ==========================================
// 2. БЛОК СТРУКТУРОВАНОГО КАТАЛОГУ (РОСЛИНИ)
// ==========================================

model Category {
  id                 String                      @id @default(uuid())
  slug               String                      @unique
  image              String?
  /// Latin / scientific name from Flexi strom.nazev (not a display translation)
  latinName          String?
  legacyId           Int?                        @unique
  isActive           Boolean                     @default(true)
  isCatalogRoot      Boolean                     @default(false)
  position           Int                         @default(0)
  parentId           String?
  parent             Category?                   @relation("CategoryToParent", fields: [parentId], references: [id])
  children           Category[]                  @relation("CategoryToParent")
  products           Product[]
  additionalProducts ProductAdditionalCategory[]

  translations CategoryTranslation[]
}

model CategoryTranslation {
  id                String  @id @default(uuid())
  locale            String
  name              String
  description       String? @db.Text
  footerDescription String? @db.Text
  metaTitle         String?
  metaDesc          String?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id                String    @id @default(uuid())
  slug              String    @unique
  latinName         String?
  /// Combined Nomenclature / Intrastat code from Flexi (e.g. 060290)
  cnCode            String?
  legacyId          String?   @unique
  isPublished       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  /**
   * Коли товар знову став доступним після повного відсутності на складі
   */
  restockedAt       DateTime?
  /**
   * Коли всі розміри вичерпались (для визначення повторного надходження)
   */
  fullyOutOfStockAt DateTime?

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  translations         ProductTranslation[]
  additionalCategories ProductAdditionalCategory[]
  variants             ProductVariant[]
  images               ProductImage[]
  characteristics      ProductCharacteristic[]
  stockNotifications   ProductStockNotification[]
  reviews              Review[]
  favorites            UserFavorite[]

  @@index([cnCode])
}

/// Підписка «повідомити, коли зʼявиться на складі» (будь-який розмір товару)
model ProductStockNotification {
  id         String    @id @default(uuid())
  productId  String
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  locale     String    @default("uk")
  /// SK host country site when subscribed (sk|hu|at). Null on UA.
  countrySiteCode String?
  consentAt  DateTime?
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([productId])
  @@index([productId, email])
  @@index([productId, phone])
  @@index([notifiedAt, createdAt])
}

model ProductAdditionalCategory {
  productId  String
  categoryId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
}

model ProductTranslation {
  id             String  @id @default(uuid())
  locale         String
  name           String
  description    String? @db.Text
  /// Comma-separated alternate search names for this locale (normalized on save).
  searchSynonyms String? @db.Text
  metaTitle      String?
  metaDesc       String?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

enum CharacteristicValueType {
  SELECT
  MULTI_SELECT
  NUMBER
  TEXT
  COLOR
}

enum VariantAttributeType {
  UNIVERSAL
  CONTAINER
  RANGE
  COLOR
  NUMBER
}

enum PackagingKind {
  POT
  ROOT_BALL
  BARE_ROOT
  POT_ROOT_BALL
}

enum ColorDisplayMode {
  TEXT
  SWATCH
  BOTH
}

/// Довідник характеристик (створюється в бек-офісі): висота, світло, полив тощо
model Characteristic {
  id                String                  @id @default(uuid())
  slug              String                  @unique
  legacyId          String?                 @unique
  valueType         CharacteristicValueType
  unit              String?
  sortOrder         Int                     @default(0)
  isFilterable      Boolean                 @default(true)
  showOnProductPage Boolean                 @default(false)
  icon              String?
  /// Для valueType COLOR: що показувати на сторінці товару
  colorDisplayMode  ColorDisplayMode?

  translations  CharacteristicTranslation[]
  options       CharacteristicOption[]
  productValues ProductCharacteristic[]
}

model CharacteristicTranslation {
  id     String @id @default(uuid())
  locale String
  name   String

  characteristicId String
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  @@unique([characteristicId, locale])
}

/// Варіанти значення для SELECT / MULTI_SELECT (напр. «повне сонце», «напівтінь»)
model CharacteristicOption {
  id               String         @id @default(uuid())
  slug             String
  legacyId         String?        @unique
  sortOrder        Int            @default(0)
  colorHex         String?
  characteristicId String
  characteristic   Characteristic @relation(fields: [characteristicId], references: [id], onDelete: Cascade)

  translations  CharacteristicOptionTranslation[]
  productValues ProductCharacteristic[]

  @@unique([characteristicId, slug])
}

model CharacteristicOptionTranslation {
  id     String @id @default(uuid())
  locale String
  label  String

  optionId String
  option   CharacteristicOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

/// Прив'язка характеристики до товару (опція, число або текст)
model ProductCharacteristic {
  id          String  @id @default(uuid())
  numberValue Float?
  textValue   String?

  productId        String
  product          Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  characteristicId String
  characteristic   Characteristic        @relation(fields: [characteristicId], references: [id], onDelete: Cascade)
  optionId         String?
  option           CharacteristicOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)

  @@unique([productId, characteristicId, optionId])
}

/// Атрибут маркування/розміру (Контейнер, Висота, Висота штамба…)
model VariantAttribute {
  id                  String               @id @default(uuid())
  slug                String               @unique
  legacyId            String?              @unique
  sortOrder           Int                  @default(0)
  valueType           VariantAttributeType @default(UNIVERSAL)
  /// Одиниця для RANGE / NUMBER (см, грн…)
  unit                String?
  isFilterable        Boolean              @default(true)
  participatesInLabel Boolean              @default(true)
  showOnProductPage   Boolean              @default(false)
  icon                String?
  /// Для valueType COLOR: що показувати на сторінці товару
  colorDisplayMode    ColorDisplayMode?

  translations VariantAttributeTranslation[]
  values       VariantAttributeValue[]
}

model VariantAttributeTranslation {
  id          String  @id @default(uuid())
  locale      String
  name        String
  description String?

  attributeId String
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  @@unique([attributeId, locale])
}

model VariantAttributeValue {
  id            String         @id @default(uuid())
  slug          String
  legacyId      String?        @unique
  sortOrder     Int            @default(0)
  /// RANGE min / NUMBER value
  numericMin    Decimal?       @db.Decimal(12, 3)
  /// RANGE max (null = «від Min», напр. H80+)
  numericMax    Decimal?       @db.Decimal(12, 3)
  /// CONTAINER — усі поля опційні (WRB без параметрів)
  volumeLiters  Decimal?       @db.Decimal(12, 3)
  potDiameterCm Decimal?       @db.Decimal(12, 3)
  potHeightCm   Decimal?       @db.Decimal(12, 3)
  tareWeightKg  Decimal?       @db.Decimal(12, 3)
  /// CONTAINER — тип упаковки / стан кореневої системи для фільтра
  packagingKind PackagingKind?
  /// COLOR
  colorHex      String?

  attributeId String
  attribute   VariantAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)

  translations VariantAttributeValueTranslation[]
  variantLinks ProductVariantAttributeValue[]

  @@unique([attributeId, slug])
}

model VariantAttributeValueTranslation {
  id     String @id @default(uuid())
  locale String
  label  String

  valueId String
  value   VariantAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@unique([valueId, locale])
}

model ProductVariant {
  id                 String    @id @default(uuid())
  sku                String?   @unique
  ean                String?   @unique
  stock              Int       @default(0)
  weight             Float?
  volume             Float?
  /// Габарити упаковки для розрахунку доставки (см / кг)
  lengthCm           Float?
  widthCm            Float?
  heightCm           Float?
  volumetricWeightKg Float?
  legacyId           String?   @unique
  /// Орієнтовна дата доступності (бронювання при нульовому залишку)
  availableFrom      DateTime?

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  salesUnitId String?
  salesUnit   UnitOfMeasure? @relation(fields: [salesUnitId], references: [id], onDelete: SetNull)

  attributeValues ProductVariantAttributeValue[]
  prices          ProductPrice[]
  priceHistory    PriceHistory[]
  quantityPrices  ProductVariantQuantityPrice[]
  cartItems       CartItem[]
  orderItems      OrderItem[]
}

enum VariantQuantityDiscountType {
  FIXED_PRICE
  PERCENT
}

/// Оптова ціна / знижка від кількості для варіанту
model ProductVariantQuantityPrice {
  id           String                      @id @default(uuid())
  minQuantity  Int
  discountType VariantQuantityDiscountType @default(FIXED_PRICE)
  /// FIXED_PRICE — ціна за од. (₴); PERCENT — знижка у %
  value        Decimal                     @db.Decimal(10, 2)
  validFrom    DateTime?
  validTo      DateTime?
  sortOrder    Int                         @default(0)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([productVariantId])
}

model ProductVariantAttributeValue {
  variantId String
  valueId   String
  variant   ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  value     VariantAttributeValue @relation(fields: [valueId], references: [id], onDelete: Cascade)

  @@id([variantId, valueId])
}

model ProductPrice {
  id             String   @id @default(uuid())
  priceType      String   @default("роздріб")
  currency       String   @default("UAH")
  value          Decimal  @db.Decimal(10, 2)
  compareAtValue Decimal? @db.Decimal(10, 2)

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  currencyRef      Currency       @relation(fields: [currency], references: [code])

  @@unique([productVariantId, priceType, currency])
}

/// Історія зміни ціни (EU Omnibus Directive — «найнижча ціна за 30 днів» перед знижкою).
model PriceHistory {
  id         String   @id @default(uuid())
  value      Decimal  @db.Decimal(10, 2)
  recordedAt DateTime @default(now())

  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  priceType        String         @default("роздріб")
  currency         String         @default("UAH")

  @@index([productVariantId, priceType, currency, recordedAt])
}

enum UnitOfMeasureType {
  COUNT
  WEIGHT
  VOLUME
  LENGTH
  AREA
}

model Currency {
  code           String   @id
  symbol         String
  /// ISO 4217 numeric code (напр. 980 для UAH)
  isoNumericCode Int?
  decimals       Int      @default(2)
  isActive       Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  translations CurrencyTranslation[]
  prices       ProductPrice[]
}

model CurrencyTranslation {
  id     String @id @default(uuid())
  locale String
  name   String

  currencyCode String
  currency     Currency @relation(fields: [currencyCode], references: [code], onDelete: Cascade)

  @@unique([currencyCode, locale])
}

model UnitOfMeasure {
  id        String            @id @default(uuid())
  code      String            @unique
  symbol    String
  type      UnitOfMeasureType
  decimals  Int               @default(0)
  isActive  Boolean           @default(true)
  sortOrder Int               @default(0)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  translations UnitOfMeasureTranslation[]
  variants     ProductVariant[]
}

model UnitOfMeasureTranslation {
  id     String @id @default(uuid())
  locale String
  name   String

  unitId String
  unit   UnitOfMeasure @relation(fields: [unitId], references: [id], onDelete: Cascade)

  @@unique([unitId, locale])
}

model ProductImage {
  id        String  @id @default(uuid())
  url       String
  isMain    Boolean @default(false)
  sortOrder Int     @default(0)
  /// PrestaShop id_image
  legacyId  String? @unique

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

// ==========================================
// 3. БЛОК СУПЕРАВТОМАТИЧНИХ ЗНИЖОК
// ==========================================

enum DiscountTarget {
  ALL_PRODUCTS
  CATEGORY
  PRODUCT
  VARIANT
}

enum DiscountValueType {
  PERCENT
  FIXED
}

enum DiscountApplicationScope {
  LINE_ITEMS
  CART_TOTAL
}

enum PromoStackingMode {
  NONE
  ALL
  ALLOWLIST
  DENYLIST
}

enum PromoDiscountCombinationMode {
  STACK
  BEST_PRICE
}

/// How auto discount rules combine with retail / qty / contractor prices
enum DiscountRuleCombinationMode {
  BEST_PRICE
  STACK
  MAX_OF
}

model CustomerGroup {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users            UserCustomerGroup[]
  discountRules    DiscountRuleGroup[]
  promoCodes       PromoCodeGroup[]
  referralPrograms ReferralProgramGroup[]
}

model UserCustomerGroup {
  userId  String
  groupId String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  group   CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

model DiscountRule {
  id                         String                      @id @default(uuid())
  name                       String
  type                       DiscountValueType
  value                      Decimal                     @db.Decimal(10, 2)
  target                     DiscountTarget
  targetId                   String?
  targetIds                  String[]                    @default([])
  excludeProductIds          String[]                    @default([])
  excludeVariantIds          String[]                    @default([])
  excludeCategoryIds         String[]                    @default([])
  onlyForRoles               Role[]
  combinesWithOtherDiscounts DiscountRuleCombinationMode @default(BEST_PRICE)
  minCartSubtotal            Decimal?                    @db.Decimal(10, 2)
  startDate                  DateTime?
  endDate                    DateTime?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt

  groups       DiscountRuleGroup[]
  allowedUsers DiscountRuleUser[]
}

model DiscountRuleGroup {
  discountRuleId String
  groupId        String
  discountRule   DiscountRule  @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  group          CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([discountRuleId, groupId])
}

model DiscountRuleUser {
  discountRuleId String
  userId         String
  discountRule   DiscountRule @relation(fields: [discountRuleId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([discountRuleId, userId])
  @@index([userId])
}

model PromoCode {
  id                         String                       @id @default(uuid())
  code                       String                       @unique
  name                       String
  description                String?
  discountType               DiscountValueType?
  value                      Decimal?                     @db.Decimal(10, 2)
  discountApplicationScope   DiscountApplicationScope     @default(LINE_ITEMS)
  combinesWithOtherDiscounts PromoDiscountCombinationMode @default(BEST_PRICE)
  stackingMode               PromoStackingMode            @default(NONE)
  compatiblePromoCodeIds     String[]                     @default([])
  target                     DiscountTarget
  targetId                   String?
  targetIds                  String[]                     @default([])
  excludeProductIds          String[]                     @default([])
  excludeVariantIds          String[]                     @default([])
  excludeCategoryIds         String[]                     @default([])
  minCartSubtotal            Decimal?                     @db.Decimal(10, 2)
  giftVariantId              String?
  giftQuantity               Int                          @default(1)
  usageLimitTotal            Int?
  usageLimitPerUser          Int?
  validFrom                  DateTime?
  validTo                    DateTime?
  isActive                   Boolean                      @default(true)
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  groups       PromoCodeGroup[]
  allowedUsers PromoCodeUser[]
  usages       PromoCodeUsage[]
  orders       Order[]
  orderLinks   OrderPromoCode[]
}

model PromoCodeUser {
  promoCodeId String
  userId      String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, userId])
  @@index([userId])
}

model PromoCodeGroup {
  promoCodeId String
  groupId     String
  promoCode   PromoCode     @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  group       CustomerGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([promoCodeId, groupId])
}

model PromoCodeUsage {
  id          String    @id @default(uuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId     String?
  createdAt   DateTime  @default(now())

  @@unique([orderId, promoCodeId])
  @@index([promoCodeId, userId])
}

// ==========================================
// 4. БЛОК КОШИКА ТА ОФОРМЛЕННЯ ЗАМОВЛЕНЬ
// ==========================================

model Cart {
  id             String     @id @default(uuid())
  userId         String?    @unique
  user           User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?    @unique
  items          CartItem[]
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id               String         @id @default(uuid())
  quantity         Int            @default(1)
  cartId           String
  cart             Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariantId String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([cartId, productVariantId])
}

model OrderStatusDefinition {
  id           String   @id @default(uuid())
  /// Stable slug used on Order.status (PENDING, AWAITING_PAYMENT, …)
  code         String   @unique
  nameUk       String
  nameEn       String?
  nameSk       String?
  /// Badge color key: yellow | orange | blue | purple | green | red | gray
  color        String   @default("yellow")
  sortOrder    Int      @default(0)
  isActive     Boolean  @default(true)
  /// Seeded system statuses cannot be deleted
  isSystem     Boolean  @default(false)
  isTerminal   Boolean  @default(false)
  /// Optional mapping code for 1C / ERP
  externalCode String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CancellationReason {
  id          String   @id @default(uuid())
  code        String   @unique
  nameUk      String
  nameEn      String?
  nameSk      String?
  allowAdmin  Boolean  @default(true)
  allowUser   Boolean  @default(false)
  allowSystem Boolean  @default(false)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      Order[]
}

model Order {
  id                     String               @id @default(uuid())
  orderNumber            Int                  @unique @default(autoincrement())
  status                 String               @default("PENDING")
  totalAmount            Decimal              @db.Decimal(10, 2)
  productsSubtotal       Decimal?             @db.Decimal(10, 2)
  deliveryAmount         Decimal?             @db.Decimal(10, 2)
  packagingAmount        Decimal?             @db.Decimal(10, 2)
  /// Snapshot: boxes used for packaging fee (packagingMode=boxes)
  packagingBoxCount      Int?
  /// Snapshot: full pallets charged in packaging fee
  packagingPalletCount   Int?
  taxAmount              Decimal?             @db.Decimal(10, 2)
  /// Snapshot of applied VAT % at checkout (SK multi-domain / OSS)
  taxRatePercent         Float?
  /// Destination / seller country code used for VAT (sk|hu|at)
  taxCountryCode         String?
  /// seller | destination | reverse_charge
  taxRegime              String?
  /// EUR→HUF rate used when currency is HUF
  fxRateUsed             Float?
  /// individual | company
  buyerType              String?
  /// Комісія за післяплату (dobierka / COD), якщо застосовна
  codFeeAmount           Decimal?             @db.Decimal(10, 2)
  pointsDiscountAmount   Decimal?             @db.Decimal(10, 2)
  currency               String               @default("UAH")
  customerFirstName      String
  customerLastName       String
  customerPatronymic     String?
  customerPhone          String
  customerEmail          String?
  receiverFirstName      String
  receiverLastName       String
  receiverPatronymic     String?
  receiverPhone          String
  deliveryMethod         String               @default("nova-poshta-branch")
  deliveryCity           String?
  deliveryBranch         String?
  deliveryStreet         String?
  deliveryHouseNumber    String?
  /// SK/EU courier postal code (PSČ)
  deliveryPostalCode     String?
  /// Shipping destination country (sk|hu|at) for SK multi-site
  deliveryCountryCode    String?
  /// Storefront host country site at checkout (sk|hu|at). Null on UA. Never delivery/tax country.
  countrySiteCode        String?
  /// Checkout UI locale snapshot (uk|en|sk|…). Used for email resume links.
  locale                 String?
  /// Optional company/org name on package recipient (not billing entity)
  receiverCompanyName    String?
  /// Human-readable Packeta / branch label (id stored in deliveryBranch)
  deliveryBranchLabel    String?
  paymentMethod          String
  comment                String?              @db.Text
  /// B2B buyer identity (SK IČO / DIČ / IČ DPH or UA ЄДРПОУ)
  companyLegalName       String?
  companyIco             String?
  companyDic             String?
  companyVatId           String?
  /// ISO VAT country prefix at checkout (SK, HU, AT, …)
  vatCountryCode         String?
  /// B2B billing address (optional; delivery used as fallback in ERP export)
  companyStreet          String?
  companyCity            String?
  companyPostalCode      String?
  /// Customer-selected preferred dispatch / ship date
  preferredShipDate      DateTime?
  monopayInvoiceId       String?              @unique
  /// Stripe PaymentIntent / Checkout Session id
  stripePaymentId        String?              @unique
  paymentProvider        String?
  paymentStatus          String?
  monopayModifiedAt      DateTime?
  privacyConsentAt       DateTime?
  privacyConsentVersion  String?
  createAccountRequested Boolean              @default(false)
  /// Nova Poshta TTN / tracking number
  trackingNumber         String?
  trackingCarrier        String?
  npDocumentRef          String?
  trackingSyncedAt       DateTime?
  shippedAt              DateTime?
  /// Actual customer delivery date when known (not derived from order status or ABRA realization dates).
  deliveredAt            DateTime?
  /// Backstage per-order toggle: hides account withdrawal CTA only (public form unaffected).
  onlineWithdrawalActionEnabled Boolean @default(true)
  cancellationReasonId   String?
  cancellationReason     CancellationReason?  @relation(fields: [cancellationReasonId], references: [id], onDelete: SetNull)
  /// ADMIN | USER | SYSTEM
  cancellationSource     String?
  cancellationNote       String?              @db.Text
  cancelledAt            DateTime?
  /// REL-002 release gate — set once when reserved stock is returned (or intentionally skipped for EXTERNAL).
  stockReleasedAt        DateTime?
  /// Customer-facing card payment deadline (createdAt + 30m). SYSTEM cancel runs at +40m.
  paymentExpiresAt       DateTime?
  /// First successful card payment timestamp.
  paidAt                 DateTime?
  awaitingPaymentEmailSentAt DateTime?
  paymentReminderEmailSentAt DateTime?
  cancelledUnpaidEmailSentAt DateTime?
  latePayRefundEmailSentAt   DateTime?
  /// ERP correlation id only (Flexi ext:GA:{uuid} / legacy). NOT the native ERP document number.
  externalErpId          String?
  /// @deprecated Use externalErpId
  externalId1C           String?
  /// ERP-SYNC-001: sync FSM separate from Order.status (customer lifecycle).
  /// NOT_REQUIRED | PENDING_ERP | RETRYING | SYNCED | ERP_CONFLICT | FAILED | CANCEL_*
  erpSyncStatus          String?
  /// Native ERP/Flexi internal document id when known (populated in later batches).
  erpNativeId            String?
  /// Native ERP/Flexi document number/kod for display when known.
  erpNativeKod           String?
  erpSyncAttempts        Int                  @default(0)
  erpLastErrorCode       String?
  erpLastErrorMessage    String?              @db.Text
  erpLastSyncAt          DateTime?
  erpSyncedAt            DateTime?
  legacyId               String?
  legacySource           String?
  legacyReference        String?
  userId                 String?
  user                   User?                @relation(fields: [userId], references: [id])
  promoCodeId            String?
  promoCode              PromoCode?           @relation(fields: [promoCodeId], references: [id], onDelete: SetNull)
  promoCodes             OrderPromoCode[]
  items                  OrderItem[]
  referralAttribution    ReferralAttribution?
  pointsLedger           PointsLedgerEntry[]
  legalConsentEvents     LegalConsentEvent[]
  contractWithdrawals    ContractWithdrawal[]
  viesCheck              OrderViesCheck?
  createdAt              DateTime             @default(now())

  @@unique([legacySource, legacyId])
  @@index([trackingNumber])
  @@index([cancellationReasonId])
  @@index([legacyId])
  @@index([externalErpId])
  @@index([erpSyncStatus])
  @@index([erpNativeKod])
  @@index([companyIco])
  @@index([preferredShipDate])
  @@index([createdAt])
  @@index([status, createdAt])
  @@index([status, paymentExpiresAt])
  @@index([userId, createdAt])
  @@index([deliveredAt])
}

enum ContractWithdrawalScope {
  ENTIRE_ORDER
  PARTIAL
}

enum ContractWithdrawalSource {
  PUBLIC_FORM
  ACCOUNT
}

enum ContractWithdrawalStatus {
  SUBMITTED
  UNDER_REVIEW
  ACCEPTED
  REJECTED
  CLOSED
}

/// Consumer exercise of the right to withdraw from a distance contract (§20a / 108/2024).
model ContractWithdrawal {
  id                             String                   @id @default(uuid())
  referenceNumber                String                   @unique
  orderId                        String?
  order                          Order?                   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  submittedOrderNumber           String
  userId                         String?
  user                           User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName                   String
  customerEmail                  String
  customerPhone                  String?
  scope                          ContractWithdrawalScope
  partialItemsText               String?                  @db.Text
  locale                         String
  source                         ContractWithdrawalSource
  status                         ContractWithdrawalStatus @default(SUBMITTED)
  submittedAt                    DateTime                 @default(now())
  acknowledgementSentAt          DateTime?
  acknowledgementLocale          String?
  acknowledgementSubjectSnapshot String?
  acknowledgementBodySnapshot    String?                  @db.Text
  ipHash                         String?
  lineItems                      ContractWithdrawalLineItem[]
  createdAt                      DateTime                 @default(now())
  updatedAt                      DateTime                 @updatedAt

  @@index([orderId])
  @@index([userId])
  @@index([customerEmail])
  @@index([submittedOrderNumber])
  @@index([status, submittedAt(sort: Desc)])
  @@index([submittedAt(sort: Desc)])
}

model ContractWithdrawalLineItem {
  id               String             @id @default(uuid())
  withdrawalId     String
  withdrawal       ContractWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)
  orderItemId      String?
  productVariantId String?
  quantity         Int
  titleSnapshot    String
  skuSnapshot      String?

  @@index([withdrawalId])
}

model OrderPromoCode {
  orderId     String
  promoCodeId String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Restrict)

  @@id([orderId, promoCodeId])
  @@index([promoCodeId])
}

model OrderItem {
  id               String          @id @default(uuid())
  quantity         Int
  /// Exact units decremented from ProductVariant.stock at create (0 for gift/preorder).
  stockDecremented Int             @default(0)
  priceAtPurchase  Decimal         @db.Decimal(10, 2)
  productName      String
  productSlug      String
  variantLabel     String?
  sku              String?
  orderId          String
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productVariantId String?
  productVariant   ProductVariant? @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
}

/// Immutable VIES audit snapshot at order placement (EU B2B reverse charge evidence).
model OrderViesCheck {
  id                   String   @id @default(uuid())
  orderId              String   @unique
  order                Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  vatCountryCode       String
  vatNumber            String
  /// true | false | null (service unavailable)
  valid                Boolean?
  checkedAt            DateTime
  viesRequestDate      String?
  requestIdentifier    String?
  registeredName       String?
  registeredAddress    String?  @db.Text
  requesterCountryCode String?
  requesterVatNumber   String?
  source               String
  rawResponse          Json?
  createdAt            DateTime @default(now())
}

// ==========================================
// 5. НАЛАШТУВАННЯ ТА КОНТЕНТ БЕК-ОФІСУ
// ==========================================

model Settings {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

enum WholesaleInquiryStatus {
  NEW
  IN_PROGRESS
  CLOSED
}

/// Public wholesale / B2B cooperation leads (storefront form).
model WholesaleInquiry {
  id           String                  @id @default(uuid())
  status       WholesaleInquiryStatus  @default(NEW)
  locale       String
  marketRegion String
  fullName     String
  companyName  String
  phone        String
  email        String
  city         String
  website      String?
  message      String?                 @db.Text
  companyIco   String?
  companyVatId String?
  consentAt    DateTime?
  ipHash       String?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([status, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
}

model Redirect {
  id         String    @id @default(uuid())
  fromPath   String    @unique
  toPath     String
  statusCode Int       @default(301)
  isActive   Boolean   @default(true)
  /// Групування / префікс для фільтрації в бек-офісі та оптимізації пошуку
  prefix     String?
  hitCount   Int       @default(0)
  lastHitAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([prefix])
  @@index([isActive])
}

/// Індекс/маніфест estimate-фото (R2 або local driver + кеш для клієнта).
/// `ean` stores the identifier *value* (EAN or SKU). Discriminator is identifierType.
model PhotoIndex {
  id             String              @id @default(uuid())
  identifierType PhotoIdentifierType @default(EAN) @map("identifier_type")
  /// Identifier value: ProductVariant.ean (UA) or ProductVariant.sku (SK)
  ean            String
  /// Унікальний id файлу (раніше google_id) — клієнтський кеш звіряється з ним
  fileId         String              @unique @map("file_id")
  hash           String
  /// URL будується на льоту з relativePath (PhotoStorageService.buildPublicUrl)
  relativePath   String              @map("relative_path")
  fileSizeBytes  Int                 @default(0) @map("file_size_bytes")
  appProperties  Json                @default("{}") @map("app_properties")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([ean])
  @@index([identifierType, ean])
  @@index([updatedAt(sort: Desc)])
  @@map("photo_index")
}

// ==========================================
// 6. НОВА ПОШТА — ДОВІДНИКИ ДОСТАВКИ
// ==========================================

model NpSettlement {
  ref                 String   @id
  description         String
  descriptionRu       String?
  descriptionTranslit String?
  settlementType      String?
  areaDescription     String?
  regionsDescription  String?
  latitude            String?
  longitude           String?
  hasWarehouse        Boolean  @default(true)
  searchText          String
  updatedAt           DateTime @updatedAt

  warehouses NpWarehouse[]

  @@index([searchText])
}

model NpWarehouseType {
  ref           String   @id
  description   String
  descriptionRu String?
  updatedAt     DateTime @updatedAt
}

model NpWarehouse {
  ref                String       @id
  settlementRef      String
  settlement         NpSettlement @relation(fields: [settlementRef], references: [ref], onDelete: Cascade)
  typeOfWarehouseRef String?
  description        String
  shortAddress       String?
  number             String?
  cityDescription    String?
  warehouseStatus    String?
  denyToSelect       Boolean      @default(false)
  searchText         String
  updatedAt          DateTime     @updatedAt

  @@index([settlementRef])
  @@index([settlementRef, searchText])
}

model NpSyncRun {
  id            String    @id @default(uuid())
  kind          String
  status        String
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  recordsTotal  Int?
  recordsSynced Int       @default(0)
  currentPage   Int       @default(0)
  error         String?   @db.Text
  jobId         String?   @unique

  @@index([status, startedAt(sort: Desc)])
}

model BlogPost {
  id              String   @id @default(uuid())
  slug            String   @unique
  title           String
  content         String   @db.Text
  /// Короткий опис (Presta content_short); для карток / SEO fallback
  excerpt         String?  @db.Text
  image           String?
  /// Автор статті (Presta author); на фронті fallback — «Зелені Янголи»
  author          String?
  metaTitle       String?
  metaDescription String?  @db.Text
  metaKeywords    String?
  /// Видимість на публічному сайті
  isPublished     Boolean  @default(true)
  /// PrestaShop st_blog id_st_blog
  legacyId        String?  @unique
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isPublished, createdAt(sort: Desc)])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

model Review {
  id                   String       @id @default(uuid())
  userId               String?
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  productId            String?
  product              Product?     @relation(fields: [productId], references: [id], onDelete: SetNull)
  authorName           String
  email                String?
  phone                String?
  text                 String       @db.Text
  image                String?
  images               String[]     @default([])
  rating               Int          @default(5)
  storeReplyText       String?      @db.Text
  storeReplyAuthorName String?
  storeReplyAt         DateTime?
  status               ReviewStatus @default(PENDING)
  legacyId             String?
  legacySource         String?
  importedAt           DateTime?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@unique([legacySource, legacyId])
  @@index([status, createdAt(sort: Desc)])
  @@index([productId, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([rating])
}

model UserFavorite {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId, createdAt(sort: Desc)])
}

// ==========================================
// 6. РЕФЕРАЛКА ТА БАЛИ
// ==========================================

model ReferralProgram {
  id                   String            @id @default(uuid())
  name                 String
  isActive             Boolean           @default(false)
  /// Discount for referee (friend)
  refereeDiscountType  DiscountValueType @default(PERCENT)
  refereeDiscountValue Decimal           @default(0) @db.Decimal(10, 2)
  /// Points awarded to referrer when friend completes qualifying order
  referrerPoints       Int               @default(0)
  minOrderSubtotal     Decimal?          @db.Decimal(10, 2)
  maxRefereeDiscount   Decimal?          @db.Decimal(10, 2)
  excludeProductIds    String[]          @default([])
  excludeCategoryIds   String[]          @default([])
  /// Empty onlyForRoles + empty groups = everyone eligible as referrer
  onlyForRoles         Role[]            @default([])
  cookieDays           Int               @default(30)
  pointsExpireDays     Int?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  groups ReferralProgramGroup[]
}

model ReferralProgramGroup {
  programId String
  groupId   String
  program   ReferralProgram @relation(fields: [programId], references: [id], onDelete: Cascade)
  group     CustomerGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([programId, groupId])
}

model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  attributions ReferralAttribution[]
}

model ReferralAttribution {
  id             String       @id @default(uuid())
  referralCodeId String
  referralCode   ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
  referrerUserId String
  referrer       User         @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: Cascade)
  refereeUserId  String?
  referee        User?        @relation("ReferralReferee", fields: [refereeUserId], references: [id], onDelete: SetNull)
  orderId        String?      @unique
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  status         String       @default("pending") // pending | rewarded | cancelled
  createdAt      DateTime     @default(now())
  rewardedAt     DateTime?

  @@index([referrerUserId, createdAt(sort: Desc)])
  @@index([referralCodeId])
}

model PointsLedgerEntry {
  id           String    @id @default(uuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  delta        Int
  balanceAfter Int
  reason       String
  orderId      String?
  order        Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, createdAt(sort: Desc)])
  @@index([orderId])
}

/// EU VAT rates by country (seed + TEDB sync). Manual rows are not overwritten by TEDB.
model VatCountryRate {
  id          String   @id @default(uuid())
  /// ISO 3166-1 alpha-2 lowercase (sk, cz, de, …)
  countryCode String
  /// standard | reduced
  rateType    String
  percent     Float
  /// CN prefixes that qualify for this reduced rate, e.g. ["0601","0602"]
  cnPrefixes  String[] @default([])
  /// tedb | manual | seed
  source      String   @default("seed")
  validFrom   DateTime @default(now())
  syncedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryCode, rateType, percent])
  @@index([countryCode, rateType])
}

/// ERP-WEBHOOK-002A: durable Flexi WebHook / Changes API notification intake.
/// Payload is change evidence only — not full cenik/order bodies.
model FlexiChangeEvent {
  id               String    @id @default(uuid())
  /// e.g. cenik, objednavka-prijata, strom
  evidence         String
  /// Flexi object id (string). Sentinel "*" for strom-wide coalesce when id absent.
  objectId         String
  operation        String    @default("")
  /// Ordering key: @in-version when present, else row globalVersion, else 0
  changeVersion    Int       @default(0)
  inVersion        Int?
  rowGlobalVersion Int?
  /// PENDING | PROCESSING | PROCESSED | FAILED | SUPERSEDED
  status           String    @default("PENDING")
  attempts         Int       @default(0)
  lastError        String?   @db.Text
  processedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([evidence, objectId, changeVersion])
  @@index([status, changeVersion])
  @@index([status, evidence, objectId])
  @@index([changeVersion])
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  COOKIES
  RETURNS
  MARKETING_CONSENT
}

enum LegalRevisionStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum LegalConsentPurpose {
  TERMS
  PRIVACY_NOTICE
  COOKIES_ANALYTICS
  MARKETING
}

enum LegalConsentAction {
  GRANTED
  WITHDRAWN
  ACKNOWLEDGED
}

/// Immutable published legal texts (GDPR accountability). Edits create a new revision.
model LegalDocument {
  id        String                   @id @default(uuid())
  type      LegalDocumentType        @unique
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  revisions LegalDocumentRevision[]
}

model LegalDocumentRevision {
  id            String               @id @default(uuid())
  documentId    String
  document      LegalDocument        @relation(fields: [documentId], references: [id], onDelete: Restrict)
  locale        String
  version       Int
  title         String
  intro         String               @db.Text
  content       String               @db.Text
  contentHash   String
  status        LegalRevisionStatus  @default(DRAFT)
  effectiveAt   DateTime             @default(now())
  publishedAt   DateTime?
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  consentEvents LegalConsentEvent[]

  @@unique([documentId, locale, version])
  @@index([documentId, locale, status, publishedAt])
  @@index([status, locale])
}

/// Append-only consent / acknowledgement log. Withdrawal inserts a new row.
model LegalConsentEvent {
  id                 String              @id @default(uuid())
  userId             String?
  user               User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  orderId            String?
  order              Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  anonymousConsentId String?
  revisionId         String
  revision           LegalDocumentRevision @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  purpose            LegalConsentPurpose
  action             LegalConsentAction
  locale             String
  source             String
  documentHash       String
  metadata           Json?
  occurredAt         DateTime            @default(now())

  @@index([userId, occurredAt])
  @@index([anonymousConsentId, occurredAt])
  @@index([orderId])
  @@index([revisionId])
  @@index([purpose, occurredAt])
}

/// REL-004: Stripe webhook event.id dedupe (Mono untouched).
model StripeWebhookEvent {
  /// Stripe Event.id (evt_…)
  id          String   @id
  type        String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
